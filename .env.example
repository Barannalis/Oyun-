# Kopyalayıp .env olarak kaydedin. Gerçek değerleri asla depoya eklemeyin.

# Yayın alan adı (DNS'te bu sunucunun IP adresine yönlendirilmiş olmalı)
DOMAIN=oyun.ornek.com

# Yayıncı paneli anahtarı. En az 24 karakter, rastgele üretilmiş olmalı.
# Üretmek için: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
HOST_TOKEN=

# Ek izin verilen kaynaklar (virgülle). Panel ve yayın ekranı aynı alan adından sunulduğu için genellikle boş bırakılır.
CORS_ORIGINS=

# TikTok LIVE adaptörü (isteğe bağlı). Resmi olmayan kütüphane kullanır, README'deki uyarılara bakın.
TIKTOK_ENABLED=0
TIKTOK_UNIQUE_ID=
SIGN_API_KEY=
